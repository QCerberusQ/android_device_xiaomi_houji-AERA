# ADB
ro.adb.secure=0
ro.boot.dynamic_partitions=true

# Gatekeeper
vendor.gatekeeper.disable_spu=true
vendor.gatekeeper.is_security_level_spu=0

# Battery Property
ro.charger.enable_suspend=1

# Stock Houji primary audio HAL (global platform remains xiaomi_sm8650).
ro.hardware.audio.primary=pineapple
