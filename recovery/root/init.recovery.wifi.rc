# Houji uses the PCIe CNSS2/Kiwi stack. Aera owns all module insertion.
on init
    setprop wifi.driver.ready false
    setprop sys.aera.wlan.up 0
    mkdir /vendor/firmware/wlan/qca_cld/kiwi_v2 0755 root root
    symlink /vendor/etc/wifi/kiwi_v2/WCNSS_qcom_cfg.ini /vendor/firmware/wlan/qca_cld/kiwi_v2/WCNSS_qcom_cfg.ini
    symlink /mnt/aera-wlan-persist/wlan/wlan_mac.bin /vendor/firmware/wlan/qca_cld/kiwi_v2/wlan_mac.bin
    chmod 0755 /vendor/bin/aera-wlan-ready.sh

# This is primary-user-data completion, not crypto HAL preparation (crypto.ready).
on property:post.decrypt.modules=true
    setprop sys.aera.wlan.up 0
    setprop wifi.driver.ready false
    start aera-wlan-ready

on property:post.decrypt.modules=false
    stop aera-wlan-ready
    setprop wifi.driver.ready false
    stop wpa_supplicant

on property:wifi.driver.ready=true && property:post.decrypt.modules=true
    mkdir /tmp/recovery 0770 root wifi
    mkdir /tmp/recovery/sockets 0770 root wifi
    start wpa_supplicant

# UI retry rechecks firmware/CNSS2/wlan0, including after a readiness timeout.
on property:sys.aera.wlan.up=1 && property:post.decrypt.modules=true
    setprop sys.aera.wlan.up 0
    start aera-wlan-ready

service wpa_supplicant /system/bin/wpa_supplicant -Dnl80211 -iwlan0 -O/tmp/recovery/sockets -c/vendor/etc/wifi/wpa_supplicant.conf
    disabled
    user root
    group root wifi inet
    seclabel u:r:recovery:s0

service aera-wlan-ready /system/bin/sh /vendor/bin/aera-wlan-ready.sh
    disabled
    oneshot
    user root
    group root wifi inet
    seclabel u:r:recovery:s0
