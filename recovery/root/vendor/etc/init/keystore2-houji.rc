# Vendor init files are parsed after system init files. Override the recovery
# service so its existing late-init start also passes through the HAL guard.
service keystore2 /system/bin/sh /vendor/bin/aera-keystore-ready.sh /tmp/misc/keystore
    override
    class early_hal
    disabled
    oneshot
    user root
    group keystore readproc log
    writepid /dev/cpuset/foreground/tasks
    seclabel u:r:recovery:s0
