#on init
#    start vendor.secure_element

service vendor.secure_element /system/bin/sh /vendor/bin/aera-secure-element-ready.sh
    class hal
    user root
    group nfc root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin:/odm/lib64
    interface aidl android.hardware.secure_element.ISecureElement/eSE1
    disabled
    seclabel u:r:recovery:s0
