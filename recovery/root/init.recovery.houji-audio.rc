# Optional audio runs after userdata/module staging, outside the init action.
on property:post.decrypt.modules=true
    write /dev/kmsg "[aera-audio] post-decrypt bootstrap requested"
    start aera-houji-audio-bootstrap

service aera-pdmapper-boot /system/bin/sh /system/bin/aera-houji-adsp.sh
    class core
    disabled
    oneshot
    user root
    group root system
    seclabel u:r:recovery:s0
    stdio_to_kmsg

service aera-houji-audio-bootstrap /system/bin/sh /system/bin/aera_audio_bootstrap.sh --late
    class hal
    disabled
    oneshot
    timeout_period 120
    user root
    group root audio system media
    seclabel u:r:recovery:s0
    stdio_to_kmsg

service aera-houji-pd-mapper /system/bin/aera-houji-pd-mapper
    class core
    disabled
    user system
    group system
    setenv LD_LIBRARY_PATH /system/lib64/aera-pdmapper:/system/lib64
    seclabel u:r:recovery:s0
    stdio_to_kmsg

service aera-dspservice /vendor/bin/aera-dspservice
    class hal
    disabled
    user system
    group system wakelock 2908
    capabilities BLOCK_SUSPEND
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-lib64:/vendor/aera-stock-odm-lib64:/vendor/aera-stock-system-lib64:/vendor/lib64:/system/lib64
    interface vendor.qti.hardware.dsp@1.0::IDspService dspservice
    seclabel u:r:recovery:s0
    stdio_to_kmsg

service aera-audioadsprpcd /vendor/bin/aera-audioadsprpcd audiopd
    class main
    disabled
    user media
    group media
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-lib64:/vendor/aera-stock-odm-lib64:/vendor/aera-stock-system-lib64:/vendor/lib64:/system/lib64
    seclabel u:r:recovery:s0
    stdio_to_kmsg

# The bootstrap starts this service only after the ALSA machine card exists.
service aera-stock-audio-hal /vendor/bin/hw/android.hardware.audio.service
    class hal
    disabled
    oneshot
    user root
    group root audio system media
    capabilities BLOCK_SUSPEND SYS_NICE
    setenv LD_LIBRARY_PATH /vendor/aera-audio-abi:/vendor/aera-stock-lib64:/vendor/aera-stock-odm-lib64:/vendor/aera-stock-system-lib64:/vendor/lib64:/system/lib64
    setenv ANDROID_ROOT /system
    setenv ANDROID_DATA /data
    socket audio_holder_socket_0 seqpacket 0666 system system
    socket audio_us_socket_0 seqpacket 0666 system system
    interface android.hardware.audio@7.0::IDevicesFactory default
    interface android.hardware.audio@7.1::IDevicesFactory default
    interface android.hardware.audio.effect@7.0::IEffectsFactory default
    interface vendor.qti.hardware.AGMIPC@1.0::IAGM default
    interface vendor.qti.hardware.pal@1.0::IPAL default
    seclabel u:r:recovery:s0
    stdio_to_kmsg

service aera-audio-primary-opener /system/bin/aera-audio-primary-opener
    class hal
    disabled
    oneshot
    user root
    group root audio
    seclabel u:r:recovery:s0
    stdio_to_kmsg
