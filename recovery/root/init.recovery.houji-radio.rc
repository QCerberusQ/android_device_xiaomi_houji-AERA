# The resident provider handles AERA connect, APN, SIM/PIN and disconnect requests.
# AERA starts saved auto-connect after userdata is accessible.
on property:twrp.modules.loaded=true
    start aera-houji-cellular

service aera-houji-cellular /system/bin/aera-cellular-provider
    class main
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
    stdio_to_kmsg
